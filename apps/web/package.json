{
  "name": "@tiktok-saas/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/run-disposable-e2e.mjs",
    "test:e2e:ui": "node e2e/run-disposable-e2e.mjs --ui",
    "test:e2e:report": "playwright show-report",
    "test:local:backup-restore": "node e2e/local-backup-restore.mjs",
    "test:local:legacy-revalidation": "node ../../scripts/test_legacy_media_revalidation.mjs",
    "media:legacy:inventory": "node ../../scripts/revalidate_legacy_media.mjs",
    "media:video-worker:local": "node ../../scripts/media-video-worker.mjs",
    "media:worker:compose": "docker compose --project-directory ../../deploy/local-worker -f ../../deploy/local-worker/compose.yaml",
    "test:video-validator": "node ../../scripts/test_video_validator.mjs",
    "test:worker-compose": "node ../../scripts/test_worker_compose.mjs",
    "test:worker-task-compose": "node ../../scripts/test_worker_task_compose.mjs",
    "benchmark:video-validator": "node ../../scripts/benchmark_video_validator.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
