# Secrets das Edge Functions. Aplique com:
#   supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já são injetadas pelo Supabase.)

# App criado em developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Deve ser IDÊNTICO ao Redirect URI cadastrado no app TikTok (Login Kit), sem query string:
#   https://<project-ref>.supabase.co/functions/v1/tiktok-oauth-callback
TIKTOK_REDIRECT_URI=

# 32 bytes em base64:  openssl rand -base64 32   (guarde também uma cópia segura da chave)
TOKEN_ENCRYPTION_KEY=

# Mesmo valor do segredo "worker_secret" do Vault (pg_cron envia no header x-worker-secret):
#   openssl rand -hex 32
WORKER_SECRET=

# Origens do front permitidas no CORS, separadas por vírgula, sem barra final.
# A PRIMEIRA recebe o redirecionamento de volta do OAuth (/canais?tiktok=...).
WEB_URL=https://autoclipe.vercel.app,http://localhost:5173,http://localhost:5174

# Domínio verificado no TikTok (só o host). As imagens saem como https://<host>/m/<token>.
# Ex.: autoclipe.vercel.app (requer o rewrite /m/:token em apps/web/vercel.json)
TIKTOK_VERIFIED_MEDIA_HOST=autoclipe.vercel.app
# Segredo do proxy de imagens: openssl rand -hex 32
MEDIA_PROXY_SECRET=

# TikTok Shop / Affiliate Creator API. O Redirect URL cadastrado no Partner Center deve ser:
# https://<project-ref>.supabase.co/functions/v1/tiktok-shop-oauth-callback
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# Opcional: use o link de autorização de Creator fornecido pelo Partner Center se variar por mercado.
TIKTOK_SHOP_CREATOR_AUTH_URL=https://shop.tiktok.com/alliance/creator/auth
# Seller Sandbox: configure only in Supabase Edge Function secrets. Keep the
# feature flag false until the Sandbox callback and token exchange are homologated.
TIKTOK_SHOP_SELLER_AUTH_URL=
TIKTOK_SHOP_SELLER_SERVICE_ID=
TIKTOK_SHOP_SELLER_REDIRECT_URI=
# Backend-only AES-256-GCM key for Seller credentials; do not reuse a browser secret.
TIKTOK_SHOP_SELLER_TOKEN_ENCRYPTION_KEY=
TIKTOK_SHOP_SANDBOX_ENABLED=false
