# Worker HMAC endpoint. In local development, start `supabase functions serve`
# with deploy/local-worker/.edge.env. Future Cloud requires a separately reviewed
# HTTPS URL and rotated worker-scoped secret; never copy a service_role here.
VIDEO_WORKER_API_URL=http://host.docker.internal:54321/functions/v1/video-worker-api
VIDEO_WORKER_API_SECRET_FILE=./secrets/video_worker_api_secret
VIDEO_VALIDATOR_TOKEN_FILE=./secrets/video_validator_token
VIDEO_VALIDATION_ATTESTATION_KEY_FILE=./secrets/video_validation_attestation_key
VIDEO_WORKER_ALLOW_CLOUD=false
WORKER_INSTANCE_ID=
