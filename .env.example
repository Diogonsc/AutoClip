# ---- Front-end (Vercel) — somente valores PÚBLICOS ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Edge Functions (supabase secrets set ...) — NUNCA no front/Vercel ----
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já são injetados pelo Supabase nas Edge Functions.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=   # https://<ref>.supabase.co/functions/v1/tiktok-oauth-callback
# 32 bytes em base64 (ex.: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=
# Mesmo valor do segredo 'worker_secret' no Vault (openssl rand -hex 32)
WORKER_SECRET=
# Origens do front (CORS), separadas por vírgula; a primeira recebe o retorno do OAuth
WEB_URL=
